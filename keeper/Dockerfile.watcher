# Live trade watcher (keeper/watcher.mjs) for Railway: a background worker, no inbound port or domain.
# Build context is the repo root (it reads deployments/elysium-testnet.json). In the Railway service set
# RAILWAY_DOCKERFILE_PATH=keeper/Dockerfile.watcher plus the runtime variables SUPABASE_SERVICE_KEY and SUPABASE_URL.

FROM node:22-alpine
WORKDIR /repo
COPY keeper/package.json keeper/package-lock.json keeper/
RUN npm ci --prefix keeper --omit=dev
COPY deployments deployments
COPY keeper/watcher.mjs keeper/
COPY keeper/src keeper/src
ENV NODE_ENV=production
USER node
WORKDIR /repo/keeper
CMD ["node", "watcher.mjs"]
